{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "app_legacy/**/*",
    "src_old/**/*",
    "constants_legacy*/**/*",
    "node_modules/**/*"
  ]
}
